# Server only. Never prefix these secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase URL and publishable/anon key (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local persistence is allowed only outside production, unless explicitly enabled.
ALLOW_LOCAL_DEMO=false
# Canonical HTTPS origin in production, e.g. https://experience.example.com
APP_ORIGIN=
